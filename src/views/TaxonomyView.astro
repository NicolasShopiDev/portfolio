---
// A grouping page: one sector or one type of work, with the projects that belong to it. The
// introduction is hand-written in src/data/taxonomies.ts; what this view adds is the list, the
// ItemList schema and the links in both directions (up to /proyectos/, across to the siblings).
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { casePath, routes, taxonomyAlternates, taxonomyPath, updated, type Lang, type TaxonomyKind } from '../i18n/routes';
import { t } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, itemList, graph } from '../lib/schema';
import { imageKey } from '../lib/images';
import { taxonomies, type Taxonomy } from '../data/taxonomies';

interface Props { lang: Lang; kind: Extract<TaxonomyKind, 'sector' | 'type'>; tax: Taxonomy }
const { lang, kind, tax } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const path = taxonomyPath(kind, tax.slug[lang], lang);

const cases = new Set((await getCollection('cases', (c) => c.id.startsWith(`${lang}/`))).map((c) => c.data.project.id));
const items = await Promise.all(
  tax.projects.map(async (slug) => {
    const project = await getEntry('projects', slug);
    if (!project) throw new Error(`Taxonomy "${kind}/${tax.slug.es}" lists "${slug}", which is not in src/content/projects/`);
    const hasCase = cases.has(slug);
    const p = project.data;
    return {
      slug,
      name: p.name,
      type: p.type[lang],
      badge: p.badge,
      year: p.year,
      tags: p.tags[lang],
      // The first sentence of the role is the summary: written for the project, not for this page.
      summary: `${p.role[lang].split('. ')[0]}.`,
      image: imageKey(p.images.dir, p.images.grid),
      href: hasCase ? casePath(slug, lang) : `${routes.projects[lang]}#${slug}`,
    };
  }),
);

// The other groups of the same kind, so a crawler reaching one of these finds the rest.
const siblings = taxonomies(kind).filter((x) => x.slug.es !== tax.slug.es);
const label = kind === 'sector' ? s.taxonomySector : s.taxonomyType;

const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.navProjects, path: routes.projects[lang] },
  { name: tax.label[lang], path },
];
const schema = graph(
  person(lang),
  website(),
  webPage({
    type: 'CollectionPage',
    path,
    name: tax.title[lang],
    description: tax.description[lang],
    lang,
    dateModified: updated.projects,
  }),
  breadcrumbs(crumbs),
  itemList(items.map((item) => ({ path: item.href, name: item.name, description: item.summary }))),
);
---
<Base
  lang={lang}
  route="projects"
  title={tax.title[lang]}
  description={tax.description[lang]}
  schema={schema}
  canonicalPath={path}
  alternates={taxonomyAlternates(kind, tax.slug)}
  switchHref={taxonomyPath(kind, tax.slug[other], other)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />{' '}
      <p class="section-label">{label}</p>{' '}
      <h1 class="section-heading">{tax.h1[lang]}</h1>{' '}
      <p class="about-lead">{tax.intro[lang]}</p>
    </div>
  </section>{' '}

  <div class="container hub-body">
    <h2 class="hub-group-title">{s.taxonomyProjectsHeading}</h2>{' '}
    <ul class="tax-list">
      {items.map((item) => (
        <><li class="tax-item">
          <div class="tax-item-img">
            <Picture image={item.image} alt={item.name} sizes="(max-width: 768px) 100vw, 320px" />
          </div>{' '}
          <p class="tax-item-type">{item.type}{' '}<span class="card-badge entry-badge">{item.badge}</span>{' '}<span class="tax-item-year">{item.year}</span></p>{' '}
          <h3 class="tax-item-name">{item.name}</h3>{' '}
          <p class="tax-item-text">{item.summary}</p>{' '}
          <p class="tax-item-tags">{item.tags.join(' · ')}</p>{' '}
          <a class="text-link" href={item.href} aria-label={`${s.viewProject}: ${item.name}`}>{s.viewProject}</a>
        </li>{' '}</>
      ))}
    </ul>{' '}

    {siblings.length > 0 && (
      <nav class="doc-links" aria-labelledby="tax-siblings-title">
        <h2 class="doc-links-title" id="tax-siblings-title">{s.docRelated}</h2>{' '}
        <ul>
          {siblings.map((x) => (
            <li><a href={taxonomyPath(kind, x.slug[lang], lang)}>{x.h1[lang]}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <p class="doc-back"><a class="text-link" href={routes.projects[lang]}>{s.projectsAll}</a></p>
  </div>{' '}

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{s.blogCtaHeading}</h2>{' '}
      <a class="btn btn--dark" href={routes.contact[lang]}>{s.blogCtaLabel}</a>
    </div>
  </section>
</Base>
