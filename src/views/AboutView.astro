---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import manifest from '../data/image-manifest.json';
import { routes, updated, type Lang } from '../i18n/routes';
import { t, seo } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, graph } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const meta = seo.about[lang];
const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.navAbout, path: routes.about[lang] },
];

// The portrait shows up as soon as assets/Img/Perfil/nicolas.jpg exists and
// npm run images has run. Without it the page falls back to a single column.
const PORTRAIT = 'Perfil/nicolas.jpg';
const portrait = PORTRAIT in manifest ? PORTRAIT : null;
const portraitFile = portrait ? (manifest as Record<string, { base: string }>)[PORTRAIT].base : null;

// Facts from the CV. The current agencies stay anonymous until they agree to be named.
const copy = {
  es: {
    eyebrow: 'Sobre mí',
    lead: 'Soy Nicolás Mateos, desarrollador Shopify freelance. Vivo en Madrid y trabajo en remoto con marcas y agencias de España, Países Bajos y el resto de Europa, en español y en inglés. Llevo con Shopify desde 2021 y por mi cuenta desde septiembre de 2022; desde octubre de 2024 soy además el único desarrollador front-end de una agencia Shopify Plus centrada en B2B, cuyas tiendas mueven en conjunto más de 36 M€ al año.',
    storyTitle: 'Cómo llegué aquí',
    story: [
      'Empecé en 2021 en VRANDED Haus, una agencia de Madrid, tocando Liquid en temas que no eran míos: responsive, arreglos y aprender dónde duele una tienda. En 2022 me puse por mi cuenta, y entre 2023 y 2024 pasé por Growthmile y Reduncle construyendo temas a medida para marcas premium, de esos en los que el diseño no se parece a nada que venga de serie.',
      'Desde finales de 2024 casi todo lo que hago es B2B, y es la parte del oficio que más me gusta. Una tienda mayorista no se parece a una tienda: se parece a cómo esa empresa ya compraba por teléfono o por Excel. La mitad del trabajo es front-end y la otra mitad es entender el pedido de verdad (cajas completas, tramos de precio, varias sedes, un ERP al otro lado) y que todo eso quepa en una pantalla sin pedir un manual.',
    ],
    portraitAlt: 'Nicolás Mateos, desarrollador Shopify freelance en Madrid',
    factsTitle: 'Datos clave',
    facts: [
      ['Ubicación', 'Madrid, España. Trabajo en remoto, en horario de Europa central.'],
      ['Con Shopify desde', 'Abril de 2021'],
      ['Freelance desde', 'Septiembre de 2022, con más de 10 proyectos'],
      ['Idiomas', 'Español (nativo) e inglés (profesional)'],
      ['Especialidades', 'Shopify Plus, B2B (cuentas de empresa, catálogos y listas de precios), Shopify Functions (JavaScript y Rust), Checkout Extensibility y extensiones de cuenta de cliente, apps embebidas, integraciones con ERP por GraphQL'],
      ['Stack', 'Liquid, JavaScript, TypeScript, Rust, Node.js, Express, React, PostgreSQL, GraphQL Admin y Storefront API, Shopify CLI'],
    ],
    timelineTitle: 'Experiencia',
    timeline: [
      ['Desde julio de 2026', 'Desarrollador Shopify (contrato, remoto)', 'Agencia de ecommerce de Países Bajos', 'Personalización de temas, funcionalidades de tienda y corrección de errores en las tiendas de sus clientes.'],
      ['Desde octubre de 2024', 'Único desarrollador front-end', 'Agencia Shopify Plus centrada en B2B, España', 'Tiendas B2B en Shopify Plus que mueven en conjunto más de 36 M€ al año, con cuentas de empresa, catálogos, listas de precios, metaobjects y metafields. Shopify Functions en JavaScript y Rust (precios por tramos, condiciones de descuento, validaciones), Checkout Extensibility y extensiones de cuenta de cliente, apps embebidas con Node.js, Express y Shopify CLI, e integraciones GraphQL con ERP junto a un equipo de backend.'],
      ['Desde septiembre de 2022', 'Desarrollador Shopify freelance', 'Agencias y clientes directos', 'Más de 10 proyectos, desde auditorías de tema de una semana hasta tiendas a medida de varios meses, incluidas migraciones a Shopify. Sistemas de asignación y reservas con Shopify Functions, apps embebidas (Node.js, Express, PostgreSQL) y extensiones de cuenta de cliente, también para marcas escandinavas y alemanas.'],
      ['Agosto de 2023 – febrero de 2024', 'Desarrollador web', 'Reduncle, agencia Shopify', 'Tiendas de influencers y webs de marcas españolas premium con diseños muy personalizados, junto a equipos de growth y CRO.'],
      ['Enero – octubre de 2023', 'Desarrollador front-end', 'Growthmile, agencia Shopify', 'Temas Shopify a medida desde cero para marcas B2C premium como Born Living Yoga, Polos El Capote, Pompeii y Name The Brand.'],
      ['Abril de 2021 – julio de 2022', 'Desarrollador front-end', 'VRANDED Haus, agencia digital (Madrid)', 'Primer puesto con Shopify: Liquid, diseño responsive, JavaScript y Git.'],
    ],
    waysTitle: 'Cómo trabajo',
    waysIntro: 'Cuatro costumbres que se repiten en casi todos los encargos, con el proyecto donde se ven.',
    ways: [
      ['Leer antes de escribir', 'En Vidal & Vidal lo primero no fue código nuevo, sino 29 plantillas huérfanas heredadas de una exportación. Siete apuntaban a vídeos que solo existían en la tienda de consumo y rompían shopify theme dev; quitarlas dejó la carpeta un 75 % más pequeña.'],
      ['Una regla, no veinte parches', 'En Émolo el acceso mayorista entero cuelga de un único predicado Liquid sobre customer.b2b? que leen todos los precios, insignias de stock y botones de compra. Quien no tiene empresa no recibe un precio ni dentro del HTML.'],
      ['Que lo cambie el cliente, no yo', 'En IVB Wellness los tramos de volumen salen de un metafield de tienda, así que mover un umbral no es una publicación de tema ni una factura: lo hacen ellos desde el admin.'],
      ['Lo que no se mide, no se promete', 'Los números de rendimiento de esta web están publicados, con la fecha en que se midieron y el comando que los vuelve a medir.'],
    ],
    waysLink: 'Ver el código y los números',
    updatedLabel: 'Actualizado en octubre de 2026',
    ctaTitle: '¿Tienes un proyecto Shopify?',
    cta: 'Escríbeme',
  },
  en: {
    eyebrow: 'About',
    lead: "I'm Nicolás Mateos, a freelance Shopify developer. I live in Madrid and work remotely with brands and agencies in Spain, the Netherlands and the rest of Europe, in Spanish and English. I have been on Shopify since 2021 and freelancing since September 2022; since October 2024 I am also the sole front-end developer at a B2B-focused Shopify Plus agency whose client storefronts add up to over €36M in annual GMV.",
    storyTitle: 'How I got here',
    story: [
      "I started in 2021 at VRANDED Haus, an agency in Madrid, writing Liquid inside themes that were not mine: responsive work, fixes, and learning where a storefront hurts. I went freelance in 2022, and through 2023 and 2024 I worked with Growthmile and Reduncle building custom themes for premium brands, the kind where the design looks like nothing that ships out of the box.",
      'Since late 2024 almost everything I do is B2B, and it is the part of the job I enjoy most. A wholesale store is not really a store: it looks like the way that company was already buying, over the phone or in a spreadsheet. Half the work is front-end and the other half is understanding the real order (full boxes, price tiers, several locations, an ERP on the other side) and fitting all of it on a screen that needs no manual.',
    ],
    portraitAlt: 'Nicolás Mateos, freelance Shopify developer in Madrid',
    factsTitle: 'Quick facts',
    facts: [
      ['Location', 'Madrid, Spain. Works remotely, on Central European time.'],
      ['On Shopify since', 'April 2021'],
      ['Freelance since', 'September 2022, with 10+ projects'],
      ['Languages', 'Spanish (native) and English (professional)'],
      ['Specialties', 'Shopify Plus, B2B (Companies, Catalogs and price lists), Shopify Functions (JavaScript and Rust), Checkout Extensibility and customer account extensions, embedded apps, GraphQL ERP integrations'],
      ['Stack', 'Liquid, JavaScript, TypeScript, Rust, Node.js, Express, React, PostgreSQL, GraphQL Admin and Storefront APIs, Shopify CLI'],
    ],
    timelineTitle: 'Experience',
    timeline: [
      ['Since July 2026', 'Shopify Developer (contract, remote)', 'Ecommerce agency, the Netherlands', "Theme customization, storefront features and bug fixes for the agency's client stores."],
      ['Since October 2024', 'Sole Front-End Developer', 'B2B-focused Shopify Plus agency, Spain', 'B2B storefronts on Shopify Plus with over €36M in combined annual GMV, built with Companies, Catalogs, price lists, metaobjects and metafields. Shopify Functions in JavaScript and Rust (tiered pricing, discount gates, validation rules), Checkout Extensibility and customer account extensions, embedded apps with Node.js, Express and the Shopify CLI, and GraphQL ERP integrations alongside a backend team.'],
      ['Since September 2022', 'Freelance Shopify Developer', 'Agencies and direct clients', '10+ engagements, from week-long theme audits to multi-month custom storefront builds, including platform migrations into Shopify. Allocation and reservation systems with Shopify Functions, embedded apps (Node.js, Express, PostgreSQL) and customer account extensibility, including work for Scandinavian and German brands.'],
      ['August 2023 – February 2024', 'Web Developer', 'Reduncle, Shopify agency', 'Large influencer storefronts and premium Spanish brand sites with highly custom designs, alongside growth and CRO teams.'],
      ['January – October 2023', 'Front-End Developer', 'Growthmile, Shopify agency', 'Custom Shopify themes built from scratch for premium B2C brands such as Born Living Yoga, Polos El Capote, Pompeii and Name The Brand.'],
      ['April 2021 – July 2022', 'Front-End Developer', 'VRANDED Haus, digital agency (Madrid)', 'First Shopify role: Liquid, responsive design, JavaScript and Git.'],
    ],
    waysTitle: 'How I work',
    waysIntro: 'Four habits that come back on almost every engagement, each with the project where you can see it.',
    ways: [
      ['Read before writing', 'At Vidal & Vidal the first job was not new code but 29 orphaned templates inherited from an export. Seven of them pointed at videos that only existed on the consumer store and broke shopify theme dev; removing them cut the folder by 75%.'],
      ['One rule, not twenty patches', 'At Émolo the whole wholesale gate hangs off a single Liquid predicate on customer.b2b? that every price, stock badge and buy button reads. A visitor without a company never receives a price, not even inside the HTML.'],
      ['Let the client change it, not me', 'At IVB Wellness the volume tiers come from a store metafield, so moving a threshold is not a theme release and not an invoice: they do it from the admin.'],
      ['What is not measured is not promised', "This site's performance numbers are published, with the date they were measured and the command that measures them again."],
    ],
    waysLink: 'See the code and the numbers',
    updatedLabel: 'Updated October 2026',
    ctaTitle: 'Got a Shopify project?',
    cta: 'Get in touch',
  },
}[lang];

const schema = graph(
  person(lang, portraitFile ? `${portraitFile}-800.webp` : undefined),
  website(),
  webPage({ type: 'ProfilePage', path: routes.about[lang], name: meta.title, description: meta.description, lang, dateModified: updated.about }),
  breadcrumbs(crumbs),
);
---
<Base lang={lang} route="about" title={meta.title} description={meta.description} schema={schema}>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />
      <p class="section-label">{copy.eyebrow}</p>
      <h1 class="section-heading">Nicolás Mateos</h1>

      <div class:list={['about-intro', !portrait && 'about-intro--text']}>
        <div class="about-intro-text">
          <p class="about-lead">{copy.lead}</p>
          <h2 class="about-story-title">{copy.storyTitle}</h2>
          {copy.story.map((paragraph) => <p class="about-story">{paragraph}</p>)}
        </div>
        {portrait && (
          <figure class="about-portrait">
            <Picture
              image={portrait}
              alt={copy.portraitAlt}
              sizes="(max-width: 1024px) 260px, 360px"
              loading="eager"
              fetchpriority="high"
              class="about-portrait-img"
            />
          </figure>
        )}
      </div>

      <p class="page-updated"><time datetime={updated.about}>{copy.updatedLabel}</time></p>
    </div>
  </section>

  <section class="about-page section">
    <div class="container about-page-grid">
      <div>
        <h2 class="about-heading">{copy.factsTitle}</h2>
        <dl class="about-facts">
          {copy.facts.map(([term, value]) => <div class="about-fact"><dt>{term}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
      <div>
        <h2 class="about-heading">{copy.timelineTitle}</h2>
        <ol class="timeline">
          {copy.timeline.map(([when, role, where, what]) => (
            <li class="timeline-item">
              <p class="timeline-when">{when}</p>
              <h3 class="timeline-role">{role}</h3>
              <p class="timeline-where">{where}</p>
              <p class="timeline-what">{what}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section ways">
    <div class="container">
      <div class="section-intro">
        <h2 class="section-heading">{copy.waysTitle}</h2>
        <div>
          <p class="section-desc">{copy.waysIntro}</p>
          <a class="text-link" href={routes.code[lang]}>{copy.waysLink}</a>
        </div>
      </div>
      <ol class="ways-list">
        {copy.ways.map(([title, body], i) => (
          <li class="way">
            <p class="way-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="way-title">{title}</h3>
            <p class="way-body">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{copy.ctaTitle}</h2>
      <a class="btn btn--dark" href={routes.contact[lang]}>{copy.cta}</a>
    </div>
  </section>
</Base>
