---
// A comparison: the table first, because that is what gets read and what gets quoted, then the
// recommendation with a name on it, then the reasoning. The table is a real <table> with a header
// row, so it survives being turned into Markdown or read out loud.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocLinks from '../components/DocLinks.astro';
import { absolute, routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, question, graph } from '../lib/schema';
import { allDocs, docAlternates, linkedTerms, publishedDocs, relatedDocs } from '../lib/docs';
import { formatDate } from '../lib/posts';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const all = await allDocs('compare');
const doc = all.find((d) => d.lang === lang && d.slug === slug);
if (!doc) throw new Error(`No comparison at src/content/compare/${lang}/${slug}.md`);
const d = doc.entry.data;
const { Content } = await render(doc.entry);

const alternates = docAlternates(doc, all);
const siblings = await publishedDocs('compare', lang);
const related = relatedDocs(doc, siblings);
const terms = await linkedTerms(doc, lang);
const heading = `${d.a} ${lang === 'es' ? 'o' : 'or'} ${d.b}`;

const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.compareHeading, path: routes.compare[lang] },
  { name: `${d.a} / ${d.b}`, path: doc.path },
];
const schema = graph(
  person(lang),
  website(),
  webPage({
    type: 'WebPage',
    path: doc.path,
    name: d.seoTitle,
    description: d.description,
    lang,
    dateModified: d.updated,
    mainEntity: `${absolute(doc.path)}#question`,
  }),
  breadcrumbs(crumbs),
  // The page answers one decision, so it is modelled as that question and its answer.
  question({
    path: doc.path,
    lang,
    question: heading,
    answer: d.verdict,
    datePublished: d.updated,
    dateModified: d.updated,
  }),
);
---
<Base
  lang={lang}
  route="compare"
  title={d.seoTitle}
  description={d.description}
  schema={schema}
  canonicalPath={doc.path}
  alternates={alternates}
  switchHref={alternates[other] ?? routes.compare[other]}
  ogType="article"
  modifiedTime={d.updated}
  noindex={d.draft}
>
  <article class="doc">
    <section class="page-head">
      <div class="container">
        <Breadcrumbs lang={lang} items={crumbs} />{' '}
        <p class="section-label">{s.compareHeading}</p>{' '}
        <h1 class="section-heading">{heading}</h1>{' '}
        <p class="doc-answer"><strong class="doc-answer-label">{s.compareVerdict}:</strong>{' '}{d.verdict}</p>{' '}
        {d.verified && (
          <p class="page-updated"><time datetime={d.verified}>{s.docVerified} {formatDate(d.verified, lang)}</time></p>
        )}
      </div>
    </section>{' '}

    <div class="container doc-body">
      <div class="compare-table-wrap">
        <h2 class="doc-links-title">{s.compareTable}</h2>{' '}
        <table class="compare-table">
          <thead>
            <tr><th scope="col">{s.compareCriterion}</th><th scope="col">{d.a}</th><th scope="col">{d.b}</th></tr>
          </thead>
          <tbody>
            {d.rows.map((row) => (
              <tr><th scope="row">{row.criterion}</th><td>{row.a}</td><td>{row.b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>{' '}

      <div class="longform"><Content /></div>{' '}
      <DocLinks lang={lang} terms={terms} related={related.map((r) => ({ path: r.path, label: `${r.entry.data.a} / ${r.entry.data.b}` }))} />{' '}
      <p class="doc-back"><a class="text-link" href={routes.compare[lang]}>{s.compareAll}</a></p>
    </div>
  </article>{' '}

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{s.blogCtaHeading}</h2>{' '}
      <a class="btn btn--dark" href={routes.contact[lang]}>{s.blogCtaLabel}</a>
    </div>
  </section>
</Base>
