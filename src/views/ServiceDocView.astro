---
// A long-tail service page, written as Markdown in src/content/services/. The two flagship pages
// (/shopify-b2b/, /shopify-plus/) use ServiceView instead, because they carry their own layout.
// What this one guarantees: the Service node in the graph, the cases that prove it, and an FAQ.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CaseCards from '../components/CaseCards.astro';
import DocLinks from '../components/DocLinks.astro';
import Faq from '../components/Faq.astro';
import { absolute, routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, service, graph } from '../lib/schema';
import { allDocs, docAlternates, linkedTerms, publishedDocs, relatedDocs } from '../lib/docs';
import { formatDate } from '../lib/posts';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const all = await allDocs('services');
const doc = all.find((d) => d.lang === lang && d.slug === slug);
if (!doc) throw new Error(`No service page at src/content/services/${lang}/${slug}.md`);
const d = doc.entry.data;
const { Content } = await render(doc.entry);

const alternates = docAlternates(doc, all);
const siblings = await publishedDocs('services', lang);
const related = relatedDocs(doc, siblings);
const terms = await linkedTerms(doc, lang);

const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.servicesHeading, path: routes.services[lang] },
  { name: d.label, path: doc.path },
];
const schema = graph(
  person(lang),
  website(),
  webPage({
    type: 'WebPage',
    path: doc.path,
    name: d.seoTitle,
    description: d.description,
    lang,
    dateModified: d.updated,
    mainEntity: `${absolute(doc.path)}#service`,
  }),
  breadcrumbs(crumbs),
  service({ path: doc.path, lang, name: d.serviceName, serviceType: d.serviceType, description: d.lead }),
);
---
<Base
  lang={lang}
  route="services"
  title={d.seoTitle}
  description={d.description}
  schema={schema}
  canonicalPath={doc.path}
  alternates={alternates}
  switchHref={alternates[other] ?? routes.services[other]}
  modifiedTime={d.updated}
  noindex={d.draft}
>
  <section class="page-head service-head">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />{' '}
      <p class="section-label">{d.label}</p>{' '}
      <h1 class="case-title">{d.h1}</h1>{' '}
      <p class="case-summary">{d.lead}</p>{' '}
      {d.verified && (
        <p class="page-updated"><time datetime={d.verified}>{s.docVerified} {formatDate(d.verified, lang)}</time></p>
      )}
    </div>
  </section>{' '}

  <div class="container service-body">
    <div class="longform"><Content /></div>
  </div>{' '}

  {d.cases.length > 0 && (
    <section class="section service-cases" aria-labelledby="service-cases-title">
      <div class="container">
        <h2 class="about-heading" id="service-cases-title">{s.taxonomyProjectsHeading}</h2>{' '}
        <CaseCards lang={lang} slugs={d.cases} />
      </div>
    </section>
  )}

  <Faq title={s.blogFaq} items={d.faq} />{' '}

  <div class="container doc-body">
    <DocLinks lang={lang} terms={terms} related={related.map((r) => ({ path: r.path, label: r.entry.data.h1 }))} />{' '}
    <p class="doc-back"><a class="text-link" href={routes.services[lang]}>{s.servicesAll}</a></p>
  </div>{' '}

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{s.blogCtaHeading}</h2>{' '}
      <a class="btn btn--dark" href={routes.contact[lang]}>{s.blogCtaLabel}</a>
    </div>
  </section>
</Base>
