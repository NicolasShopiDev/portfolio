---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { routes, updated, type Lang } from '../i18n/routes';
import { t, seo } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, sourceCode, graph } from '../lib/schema';
import metrics from '../data/site-metrics.json';
import '../styles/code.css';

// The snippets are real files in this repo, read at build time: what the page shows and
// what someone clones are the same bytes, and the editor lints them like any other code.
import casePack from '../snippets/case-pack-validation.js?raw';
import casePackInput from '../snippets/case-pack-validation.graphql?raw';
import quickOrder from '../snippets/quick-order.js?raw';
import locationPicker from '../snippets/b2b-location-picker.liquid?raw';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const meta = seo.code[lang];
const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.navCode, path: routes.code[lang] },
];

const GITHUB = 'https://github.com/NicolasShopiDev';
const nf = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB');
const seconds = (ms: number) => `${nf.format(ms / 1000)} s`;
const kib = (bytes: number) => `${nf.format(Math.round(bytes / 1024))} KiB`;
const measured = new Date(`${metrics.measured}T00:00:00Z`).toLocaleDateString(
  lang === 'es' ? 'es-ES' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);

const copy = {
  es: {
    eyebrow: 'Código',
    heading: 'Código a la vista',
    lead: 'Lo que escribo para un cliente es suyo y vive en su repositorio privado. Esto es lo que sí puedo enseñar: dos repositorios públicos que puedes clonar y ejecutar, tres patrones que repito en casi todos los proyectos B2B y las decisiones técnicas de esta misma web, con sus números.',
    reposTitle: 'Repositorios públicos',
    repos: [
      {
        name: 'shopify-checkout-lab',
        lang: 'JavaScript · Shopify Functions',
        desc: 'La Shopify Function que se ejecuta en el Checkout Lab de la portada: el mismo archivo que se despliega en una tienda, con su consulta de entrada y sus tests. En el Lab puedes cambiarle la configuración y ver qué deja de pasar.',
        href: `${GITHUB}/shopify-checkout-lab`,
        extra: { label: 'Probarla en el Lab', href: `${routes.home.es}#lab` },
      },
      {
        name: 'portfolio',
        lang: 'Astro · JavaScript',
        desc: 'Esta web. Dos idiomas sin librería de i18n, imágenes AVIF y WebP generadas con sharp antes del build, y un esquema de contenido que rompe la compilación si a un proyecto le falta una traducción o una captura.',
        href: `${GITHUB}/portfolio`,
      },
    ],
    patternsTitle: 'Tres patrones B2B',
    patternsIntro: 'Ninguno es código de cliente: están reescritos desde cero para poder publicarlos. El problema que resuelven sí es real y se repite en casi todos los proyectos mayoristas.',
    problemLabel: 'El problema',
    trapLabel: 'La trampa',
    patterns: [
      {
        id: 'case-pack',
        title: 'Cajas completas en el checkout',
        problem: 'El mayorista pide 7 unidades de algo que sale del almacén en cajas de 6. O alguien abre una caja, o se arregla por teléfono dos días después. Una Function de validación lo corta en el checkout y dice exactamente qué cambiar.',
        trap: 'El target también se ejecuta mientras se edita el carrito: sin la salida temprana, el comprador no puede teclear 7 de camino a 12. Y hay presupuesto —11 millones de instrucciones y 128 kB de entrada—, así que la consulta pide solo los cuatro campos que la función mira.',
        files: [
          { name: 'src/cart_validations_generate_run.js', code: casePack, lang: 'js' },
          { name: 'src/run.graphql', code: casePackInput, lang: 'graphql' },
        ],
      },
      {
        id: 'quick-order',
        title: 'Cuarenta líneas, una petición',
        problem: 'Un bloc de pedido B2B con 40 SKUs y una casilla de cantidad en cada fila. Con una petición por línea el carrito parpadea cuarenta veces y la última respuesta puede llegar antes que la primera. La API de carrito acepta un array, y de paso devuelve el HTML de las secciones que hay que repintar.',
        trap: 'AbortController: el segundo clic cancela el primero en lugar de competir con él. Y cuando una variante está agotada, el 422 trae una descripción legible; enseñarla sale más barato que atender el correo.',
        files: [{ name: 'assets/quick-order.js', code: quickOrder, lang: 'js' }],
      },
      {
        id: 'location-picker',
        title: 'Manda la sede, no el cliente',
        problem: 'Un comprador B2B compra para varias sedes de su empresa, y la sede decide el catálogo, la lista de precios y las condiciones de pago. Si el selector vive escondido en la página de cuenta, el carrito se llena con los precios de la sede equivocada.',
        trap: 'customer.b2b? es falso para quien no ha iniciado sesión, así que no sirve por sí solo para ocultar precios al público. Y al cambiar de sede cambia el catálogo entero: cualquier cosa cacheada por página tiene que variar con ella.',
        files: [{ name: 'snippets/b2b-location-picker.liquid', code: locationPicker, lang: 'liquid' }],
      },
    ],
    siteTitle: 'Esta web, por dentro',
    siteIntro: 'Un portfolio lento sería una contradicción. Estos son los números y lo que hay detrás de ellos.',
    scoreLabels: {
      performance: 'Rendimiento',
      accessibility: 'Accesibilidad',
      bestPractices: 'Prácticas recomendadas',
      seo: 'SEO',
    },
    metricLabels: { lcp: 'LCP', cls: 'CLS', tbt: 'TBT', weight: 'Peso', requests: 'Peticiones' },
    // Shown only while the note is still true, which is while the points are still missing.
    scoreNotes: {
      performance: '',
      accessibility: 'El Checkout Lab se quedaba atenuado mientras esperaba a cargar, y el auditor leía ese gris como si fuera texto definitivo. Ahora espera en inert —ni foco de teclado ni lectura de pantalla hasta que responde—, así que la próxima medición debería marcar 100.',
      bestPractices: '',
      seo: 'Los ocho puntos son la directiva Content-Signal del robots.txt, que Lighthouse todavía no reconoce. Está puesta a propósito: dice que los buscadores y los asistentes de IA pueden leer y citar este sitio.',
    },
    method: `${metrics.tool}, móvil emulado con 4G, medido el ${measured} sobre ${metrics.url}.`,
    verify: 'Compruébalo tú mismo en PageSpeed Insights',
    howTitle: 'Las decisiones',
    how: [
      'HTML estático. Astro genera las páginas en el build; en el navegador no hay framework, solo el JavaScript propio del menú, el modal de proyectos y el formulario.',
      'Las imágenes se generan antes del build con sharp (AVIF y WebP, tres anchos) y se sirven con width y height. Por eso el CLS es 0.',
      'Fuentes variables desde el propio dominio, con preload solo de la que pinta el titular.',
      'Cloudflare sirve los archivos ya construidos; los que llevan hash en el nombre van con immutable y un año de caché.',
      'El Checkout Lab, lo más pesado de la portada, no se descarga hasta que estás a 600 px de él, y hasta que responde se queda inert: ni foco de teclado ni lectura de pantalla sobre un widget que todavía no contesta.',
    ],
    ctaTitle: '¿Tienes un proyecto Shopify?',
    cta: 'Escríbeme',
  },
  en: {
    eyebrow: 'Code',
    heading: 'Code in the open',
    lead: "What I write for a client belongs to them and lives in their private repository. This is what I can show: two public repositories you can clone and run, three patterns I repeat on almost every B2B project, and the technical decisions behind this very site, with the numbers.",
    reposTitle: 'Public repositories',
    repos: [
      {
        name: 'shopify-checkout-lab',
        lang: 'JavaScript · Shopify Functions',
        desc: 'The Shopify Function running in the Checkout Lab on the home page: the same file that ships to a store, with its input query and its tests. In the Lab you can change its configuration and watch what stops working.',
        href: `${GITHUB}/shopify-checkout-lab`,
        extra: { label: 'Play with it in the Lab', href: `${routes.home.en}#lab` },
      },
      {
        name: 'portfolio',
        lang: 'Astro · JavaScript',
        desc: 'This site. Two languages without an i18n library, AVIF and WebP images generated with sharp before the build, and a content schema that fails the build when a project is missing a translation or a screenshot.',
        href: `${GITHUB}/portfolio`,
      },
    ],
    patternsTitle: 'Three B2B patterns',
    patternsIntro: 'None of this is client code: it is rewritten from scratch so it can be published. The problem each one solves is real, and it comes back on almost every wholesale project.',
    problemLabel: 'The problem',
    trapLabel: 'The catch',
    patterns: [
      {
        id: 'case-pack',
        title: 'Full boxes at checkout',
        problem: 'A wholesale buyer orders 7 units of something that leaves the warehouse in boxes of 6. Either somebody opens a box, or it gets sorted out on the phone two days later. A validation Function stops it at checkout and says exactly what to change.',
        trap: 'The target also runs while the cart is being edited: without the early return, the buyer cannot type 7 on the way to 12. And there is a budget — 11 million instructions and a 128 kB input — so the query asks for the four fields the function actually reads.',
        files: [
          { name: 'src/cart_validations_generate_run.js', code: casePack, lang: 'js' },
          { name: 'src/run.graphql', code: casePackInput, lang: 'graphql' },
        ],
      },
      {
        id: 'quick-order',
        title: 'Forty lines, one request',
        problem: 'A B2B order pad with 40 SKUs and a quantity box on every row. One request per line makes the cart flash forty times, and the last response can land before the first. The Cart API takes an array, and it hands back the HTML of the sections that need repainting.',
        trap: 'AbortController: the second click cancels the first instead of racing it. And when a variant is sold out, the 422 carries a readable description — showing it is cheaper than answering the email.',
        files: [{ name: 'assets/quick-order.js', code: quickOrder, lang: 'js' }],
      },
      {
        id: 'location-picker',
        title: 'The location decides, not the customer',
        problem: 'A B2B buyer purchases for several company locations, and the location decides the catalog, the price list and the payment terms. If the picker hides in the account page, the cart fills up with the wrong prices.',
        trap: "customer.b2b? is false for logged-out visitors, so on its own it won't hide prices from the public. And switching location switches the whole catalog: anything cached per page has to vary with it.",
        files: [{ name: 'snippets/b2b-location-picker.liquid', code: locationPicker, lang: 'liquid' }],
      },
    ],
    siteTitle: 'This site, from the inside',
    siteIntro: 'A slow portfolio would be a contradiction. Here are the numbers, and what sits behind them.',
    scoreLabels: {
      performance: 'Performance',
      accessibility: 'Accessibility',
      bestPractices: 'Best practices',
      seo: 'SEO',
    },
    metricLabels: { lcp: 'LCP', cls: 'CLS', tbt: 'TBT', weight: 'Weight', requests: 'Requests' },
    // Shown only while the note is still true, which is while the points are still missing.
    scoreNotes: {
      performance: '',
      accessibility: 'The Checkout Lab used to dim itself while waiting to load, and the auditor read that grey as finished text. It now waits inert instead — no keyboard focus and no screen-reader output until it answers — so the next measurement should read 100.',
      bestPractices: '',
      seo: "The eight points are the Content-Signal line in robots.txt, which Lighthouse doesn't know yet. It is there on purpose: it says search engines and AI assistants may read and quote this site.",
    },
    method: `${metrics.tool}, emulated mobile on 4G, measured on ${measured} against ${metrics.url}.`,
    verify: 'Check it yourself on PageSpeed Insights',
    howTitle: 'The decisions',
    how: [
      'Static HTML. Astro builds the pages; the browser gets no framework, only the small amount of JavaScript behind the menu, the project modal and the form.',
      'Images are generated before the build with sharp (AVIF and WebP, three widths) and served with width and height. That is why CLS is 0.',
      'Variable fonts from this domain, preloading only the one that paints the headline.',
      'Cloudflare serves the built files; the ones with a hash in the name go out immutable, cached for a year.',
      'The Checkout Lab, the heaviest thing on the home page, is not downloaded until you are 600 px away from it, and it stays inert until it answers: no keyboard focus and no screen-reader output for a widget that cannot respond yet.',
    ],
    ctaTitle: 'Got a Shopify project?',
    cta: 'Get in touch',
  },
}[lang];

const psi = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(metrics.url)}`;
const scoreRows = (['performance', 'accessibility', 'bestPractices', 'seo'] as const).map((key) => ({
  label: copy.scoreLabels[key],
  value: metrics.scores[key],
  note: metrics.scores[key] < 100 ? copy.scoreNotes[key] : '',
}));
const openNotes = scoreRows.filter((row) => row.note);
const metricRows = [
  { label: copy.metricLabels.lcp, value: seconds(metrics.metrics.lcpMs) },
  { label: copy.metricLabels.cls, value: nf.format(metrics.metrics.cls) },
  { label: copy.metricLabels.tbt, value: `${nf.format(metrics.metrics.tbtMs)} ms` },
  { label: copy.metricLabels.weight, value: kib(metrics.metrics.transferBytes) },
  { label: copy.metricLabels.requests, value: nf.format(metrics.metrics.requests) },
];

const schema = graph(
  person(lang),
  website(),
  webPage({ type: 'WebPage', path: routes.code[lang], name: meta.title, description: meta.description, lang, dateModified: updated.code }),
  breadcrumbs(crumbs),
  sourceCode(
    routes.code[lang],
    copy.patterns.map((p) => ({
      id: p.id,
      name: p.title,
      description: p.problem,
      language: p.files[0].lang === 'js' ? 'JavaScript' : p.files[0].lang === 'liquid' ? 'Liquid' : 'GraphQL',
    })),
  ),
);
---
<Base lang={lang} route="code" title={meta.title} description={meta.description} schema={schema}>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />
      <p class="section-label">{copy.eyebrow}</p>
      <h1 class="section-heading">{copy.heading}</h1>
      <p class="about-lead">{copy.lead}</p>
    </div>
  </section>

  <section class="section repos">
    <div class="container">
      <h2 class="about-heading">{copy.reposTitle}</h2>
      <div class="repo-grid">
        {copy.repos.map((repo) => (
          <article class="repo">
            <p class="repo-lang">{repo.lang}</p>
            <h3 class="repo-name"><code>{repo.name}</code></h3>
            <p class="repo-desc">{repo.desc}</p>
            <p class="repo-links">
              <a class="text-link" href={repo.href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              {repo.extra && <a class="text-link" href={repo.extra.href}>{repo.extra.label}</a>}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section patterns">
    <div class="container">
      <div class="section-intro">
        <h2 class="section-heading">{copy.patternsTitle}</h2>
        <p class="section-desc">{copy.patternsIntro}</p>
      </div>

      {copy.patterns.map((pattern) => (
        <article class="pattern" id={pattern.id}>
          <div class="pattern-text">
            <h3 class="pattern-title">{pattern.title}</h3>
            <p class="pattern-label">{copy.problemLabel}</p>
            <p class="pattern-body">{pattern.problem}</p>
            <p class="pattern-label">{copy.trapLabel}</p>
            <p class="pattern-body">{pattern.trap}</p>
          </div>
          <div class="pattern-code">
            {pattern.files.map((file) => (
              <figure class="snippet">
                <figcaption class="snippet-name">{file.name}</figcaption>
                <Code code={file.code.trimEnd()} lang={file.lang as 'js' | 'graphql' | 'liquid'} theme="github-dark-default" />
              </figure>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section colophon">
    <div class="container">
      <div class="section-intro">
        <h2 class="section-heading">{copy.siteTitle}</h2>
        <p class="section-desc">{copy.siteIntro}</p>
      </div>

      <div class="metrics">
        <dl class="metric-scores">
          {scoreRows.map((row) => (
            <div class="metric-score">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
        <dl class="metric-vitals">
          {metricRows.map((row) => (
            <div class="metric-vital">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <p class="metric-method">
        {copy.method}{' '}
        <a href={psi} target="_blank" rel="noopener noreferrer">{copy.verify} ↗</a>
      </p>

      {openNotes.length > 0 && (
        <ul class="metric-notes">
          {openNotes.map((row) => (
            <li><b>{row.label} {row.value}.</b> {row.note}</li>
          ))}
        </ul>
      )}

      <h3 class="about-heading colophon-how">{copy.howTitle}</h3>
      <ul class="how-list">
        {copy.how.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{copy.ctaTitle}</h2>
      <a class="btn btn--dark" href={routes.contact[lang]}>{copy.cta}</a>
    </div>
  </section>
</Base>
