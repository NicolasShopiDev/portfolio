---
// One question per page. The H1 is the question as people ask it, and the paragraph under it is
// the whole answer in two sentences. If someone reads only that, they got what they came for;
// the rest is the reasoning, the exception and where to go next.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocLinks from '../components/DocLinks.astro';
import { absolute, routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, question, graph } from '../lib/schema';
import { allDocs, docAlternates, linkedTerms, publishedDocs, relatedDocs } from '../lib/docs';
import { formatDate } from '../lib/posts';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const all = await allDocs('questions');
const doc = all.find((d) => d.lang === lang && d.slug === slug);
if (!doc) throw new Error(`No question at src/content/questions/${lang}/${slug}.md`);
const d = doc.entry.data;
const { Content } = await render(doc.entry);

const alternates = docAlternates(doc, all);
const siblings = await publishedDocs('questions', lang);
const related = relatedDocs(doc, siblings);
const terms = await linkedTerms(doc, lang);

const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.questionsHeading, path: routes.questions[lang] },
  { name: d.question, path: doc.path },
];
const schema = graph(
  person(lang),
  website(),
  webPage({
    type: 'WebPage',
    path: doc.path,
    name: d.seoTitle,
    description: d.description,
    lang,
    dateModified: d.updated,
    mainEntity: `${absolute(doc.path)}#question`,
  }),
  breadcrumbs(crumbs),
  question({
    path: doc.path,
    lang,
    question: d.question,
    answer: d.answer,
    datePublished: d.updated,
    dateModified: d.updated,
  }),
);
---
<Base
  lang={lang}
  route="questions"
  title={d.seoTitle}
  description={d.description}
  schema={schema}
  canonicalPath={doc.path}
  alternates={alternates}
  switchHref={alternates[other] ?? routes.questions[other]}
  ogType="article"
  modifiedTime={d.updated}
  noindex={d.draft}
>
  <article class="doc">
    <section class="page-head">
      <div class="container">
        <Breadcrumbs lang={lang} items={crumbs} />{' '}
        <p class="section-label">{s.categories[d.category]}</p>{' '}
        <h1 class="section-heading doc-question">{d.question}</h1>{' '}
        <p class="doc-answer"><strong class="doc-answer-label">{s.docAnswerLabel}:</strong>{' '}{d.answer}</p>{' '}
        {d.verified && (
          <p class="page-updated"><time datetime={d.verified}>{s.docVerified} {formatDate(d.verified, lang)}</time></p>
        )}
      </div>
    </section>{' '}

    <div class="container doc-body">
      <div class="longform"><Content /></div>{' '}
      <DocLinks lang={lang} terms={terms} related={related.map((r) => ({ path: r.path, label: r.entry.data.question }))} />{' '}
      <p class="doc-back"><a class="text-link" href={routes.questions[lang]}>{s.questionsAll}</a></p>
    </div>
  </article>{' '}

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{s.blogCtaHeading}</h2>{' '}
      <a class="btn btn--dark" href={routes.contact[lang]}>{s.blogCtaLabel}</a>
    </div>
  </section>
</Base>
