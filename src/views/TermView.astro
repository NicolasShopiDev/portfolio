---
// One glossary entry. The shape is deliberate: the definition is the first paragraph, alone, so
// an assistant quoting this page quotes a sentence that stands on its own. Everything that needs
// context (the limit, what it means on a real project) comes after it.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocLinks from '../components/DocLinks.astro';
import { absolute, routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { person, website, webPage, breadcrumbs, definedTerm, definedTermSet, graph } from '../lib/schema';
import { allDocs, docAlternates, linkedTerms, publishedDocs, relatedDocs } from '../lib/docs';
import { formatDate } from '../lib/posts';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const all = await allDocs('terms');
const doc = all.find((d) => d.lang === lang && d.slug === slug);
if (!doc) throw new Error(`No glossary term at src/content/terms/${lang}/${slug}.md`);
const d = doc.entry.data;
const { Content } = await render(doc.entry);

const alternates = docAlternates(doc, all);
const siblings = await publishedDocs('terms', lang);
const related = relatedDocs(doc, siblings);
const terms = await linkedTerms(doc, lang);

const crumbs = [
  { name: s.home, path: routes.home[lang] },
  { name: s.glossaryHeading, path: routes.glossary[lang] },
  { name: d.term, path: doc.path },
];
const schema = graph(
  person(lang),
  website(),
  webPage({
    type: 'WebPage',
    path: doc.path,
    name: d.seoTitle,
    description: d.description,
    lang,
    dateModified: d.updated,
    mainEntity: `${absolute(doc.path)}#term`,
  }),
  breadcrumbs(crumbs),
  definedTermSet({ lang, name: s.glossaryHeading, description: s.glossaryIntro }),
  definedTerm({ path: doc.path, lang, term: d.term, aliases: d.aliases, description: d.answer }),
);
---
<Base
  lang={lang}
  route="glossary"
  title={d.seoTitle}
  description={d.description}
  schema={schema}
  canonicalPath={doc.path}
  alternates={alternates}
  switchHref={alternates[other] ?? routes.glossary[other]}
  ogType="article"
  modifiedTime={d.updated}
  noindex={d.draft}
>
  <article class="doc">
    <section class="page-head">
      <div class="container">
        <Breadcrumbs lang={lang} items={crumbs} />{' '}
        <p class="section-label">{s.categories[d.category]}</p>{' '}
        <h1 class="section-heading">{d.term}</h1>{' '}
        <p class="doc-answer">{d.answer}</p>{' '}
        {d.aliases.length > 0 && (
          <p class="doc-aliases">{lang === 'es' ? 'También: ' : 'Also called: '}{d.aliases.join(', ')}</p>
        )}
        {d.verified && (
          <p class="page-updated"><time datetime={d.verified}>{s.docVerified} {formatDate(d.verified, lang)}</time></p>
        )}
      </div>
    </section>{' '}

    <div class="container doc-body">
      <div class="longform"><Content /></div>{' '}
      <DocLinks lang={lang} terms={terms} related={related.map((r) => ({ path: r.path, label: r.entry.data.term }))} />{' '}
      <p class="doc-back"><a class="text-link" href={routes.glossary[lang]}>{s.glossaryAll}</a></p>
    </div>
  </article>{' '}

  <section class="page-cta section">
    <div class="container page-cta-inner">
      <h2 class="contact-heading">{s.blogCtaHeading}</h2>{' '}
      <a class="btn btn--dark" href={routes.contact[lang]}>{s.blogCtaLabel}</a>
    </div>
  </section>
</Base>
