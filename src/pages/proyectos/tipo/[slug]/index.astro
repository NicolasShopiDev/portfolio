---
import TaxonomyView from '../../../../views/TaxonomyView.astro';
import { taxonomies } from '../../../../data/taxonomies';

export async function getStaticPaths() {
  return taxonomies('type').map((tax) => ({ params: { slug: tax.slug.es }, props: { tax } }));
}

const { tax } = Astro.props;
---
<TaxonomyView lang="es" kind="type" tax={tax} />
