---
import '../styles/style.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/inter/wght.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Página no encontrada | Nicolás Mateos</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="not-found">
    <div class="container">
      <p class="section-label">404</p>
      <h1 class="section-heading">Página no encontrada</h1>
      <p class="section-desc">Esta página no existe o ha cambiado de dirección.</p>
      <p class="not-found-links">
        <a class="btn btn--dark" href="/">Ir al inicio</a>
        <a class="btn btn--outline" href="/proyectos/">Ver proyectos</a>
        <a class="btn btn--outline" href="/shopify-b2b/">Shopify B2B</a>
        <a class="btn btn--outline" href="/shopify-plus/">Shopify Plus</a>
      </p>
      <p class="section-desc" lang="en">Page not found. <a class="text-link" href="/en/">Go to the English home page</a></p>
    </div>
  </main>
</body>
</html>
