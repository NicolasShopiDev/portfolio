---
import PostView from '../../../views/PostView.astro';
import { allPosts } from '../../../lib/posts';

// Drafts get a page too (readable on a preview branch) but are noindex and unlisted.
export async function getStaticPaths() {
  const posts = (await allPosts()).filter((post) => post.lang === 'es');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { slug: post.slug } }));
}

const { slug } = Astro.props;
---
<PostView lang="es" slug={slug} />
