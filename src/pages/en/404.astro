---
import '../../styles/style.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/inter/wght.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page not found | Nicolás Mateos</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="not-found">
    <div class="container">
      <p class="section-label">404</p>
      <h1 class="section-heading">Page not found</h1>
      <p class="section-desc">This page does not exist or has moved.</p>
      <p class="not-found-links">
        <a class="btn btn--dark" href="/en/">Go to the home page</a>
        <a class="btn btn--outline" href="/en/projects/">View projects</a>
      </p>
      <p class="section-desc" lang="es">Página no encontrada. <a class="text-link" href="/">Ir al inicio en español</a></p>
    </div>
  </main>
</body>
</html>
