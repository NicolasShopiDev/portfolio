---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import displayFont from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import '../styles/style.css';
import '../styles/lab.css';
import '../styles/blog.css';
import '../styles/docs.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { routes, absolute, alternatesOf, LANGS, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  schema: string;
  /** For pages that are not a fixed entry in the routes map (articles). Defaults to this page's URL in `alternates`. */
  canonicalPath?: string;
  /** This same page in each language (case studies, articles). Defaults to routes[route]. A language that is missing gets no hreflang tag. */
  alternates?: Partial<Record<Lang, string>>;
  /** Where the language switch points. Defaults to the same page in the other language, or its home page. */
  switchHref?: string;
  ogType?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang,
  route,
  title,
  description,
  schema,
  canonicalPath,
  alternates,
  switchHref,
  ogType,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const pairs = alternates ?? alternatesOf(route);
const canonical = absolute(canonicalPath ?? pairs[lang]!);
const xDefault = pairs.en ? absolute(pairs.en) : canonical;
// A page without a version in the other language (/shopify-plus/) switches to that language's home.
const other: Lang = lang === 'es' ? 'en' : 'es';
const switchTo = switchHref ?? pairs[other] ?? routes.home[other];
const ogImage = absolute(lang === 'es' ? '/assets/og-image-es.png' : '/assets/og-image.png');
const ogAlt = lang === 'es'
  ? 'Nicolás Mateos, desarrollador Shopify Plus y B2B freelance en Madrid, España'
  : 'Nicolás Mateos, freelance Shopify Plus and B2B developer in Madrid, Spain';
const s = t(lang);
// Cloudflare Web Analytics: cookieless, so it needs no consent banner. The token is public (it ships
// in every page). Empty means no beacon; dev builds never send one.
const CF_ANALYTICS_TOKEN = 'af4b419e023e434e8a7689ecf73c1553';
const cfBeacon = import.meta.env.PROD && CF_ANALYTICS_TOKEN
  ? JSON.stringify({ token: CF_ANALYTICS_TOKEN })
  : null;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Nicolás Mateos" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <script is:inline>document.documentElement.classList.add('js');</script>
  {route === 'home' && lang === 'es' && (
    <script is:inline>
      // The home page, and only the home page, reads the browser language. It sits here in the
      // head, undeferred, so the call is made before anything paints. It stands aside for crawlers
      // (they should see both versions) and for anyone who already picked a language with the
      // ES/EN switch, which writes the cookie main.js reads.
      (function () {
        try {
          if (location.pathname !== '/') return;
          if (/(^|;\s*)lang=/.test(document.cookie)) return;
          if (/bot|crawl|spider|slurp|lighthouse|pagespeed|preview/i.test(navigator.userAgent)) return;
          var idioma = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (!idioma || idioma.toLowerCase().indexOf('es') === 0) return;
          location.replace('/en/' + location.search + location.hash);
        } catch (e) {
          // If anything in here fails, the home page simply stays as it is.
        }
      })();
    </script>
  )}
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => pairs[l] && <link rel="alternate" hreflang={l} href={absolute(pairs[l]!)} />)}
  <link rel="alternate" hreflang="x-default" href={xDefault} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={lang === 'es' ? 'Blog de Nicolás Mateos' : "Nicolás Mateos' blog"}
    href={`${routes.blog[lang]}rss.xml`}
  />

  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <meta property="og:type" content={ogType ?? (route === 'about' ? 'profile' : 'website')} />
  <meta property="og:site_name" content="Nicolás Mateos" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  {pairs[other] && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  {route === 'about' && <meta property="profile:first_name" content="Nicolás" />}
  {route === 'about' && <meta property="profile:last_name" content="Mateos" />}
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {publishedTime && <meta property="article:author" content="Nicolás Mateos" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={schema} />
</head>
<body>
  <a href="#main-content" class="skip-to-content">{s.skip}</a>
  <Nav lang={lang} route={route} switchHref={switchTo} />
  <main id="main-content">
    <slot />
  </main>
  <Footer lang={lang} route={route} switchHref={switchTo} />
  <script src="../scripts/main.js"></script>
  {cfBeacon && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>
  )}
</body>
</html>
