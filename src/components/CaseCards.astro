---
// Cards linking to case study pages, used on service pages. The link sits outside the heading:
// text extractors drop headings that are links.
import { getEntry } from 'astro:content';
import Picture from './Picture.astro';
import { casePath, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { imageKey } from '../lib/images';

interface Props { lang: Lang; slugs: string[] }
const { lang, slugs } = Astro.props;
const s = t(lang);
const items = await Promise.all(slugs.map(async (slug) => {
  const project = await getEntry('projects', slug);
  const entry = await getEntry('cases', `${lang}/${slug}`);
  if (!project || !entry) throw new Error(`No case study for ${slug} in ${lang}`);
  return { slug, project: project.data, summary: entry.data.summary };
}));
---
<ul class="case-cards">
  {items.map(({ slug, project, summary }) => (
    <><li class="case-card">
      <div class="case-card-img">
        <Picture image={imageKey(project.images.dir, project.images.grid)} alt={project.name} sizes="(max-width: 768px) 100vw, 360px" />
      </div>{' '}
      <p class="case-card-type">{project.type[lang]}{' '}<span class="card-badge entry-badge">{project.badge}</span></p>{' '}
      <h3 class="case-card-name">{project.name}</h3>{' '}
      <p class="case-card-text">{summary}</p>{' '}
      <a class="text-link" href={casePath(slug, lang)} aria-label={`${s.readCase}: ${project.name}`}>{s.readCase}</a>
    </li>{' '}</>
  ))}
</ul>
