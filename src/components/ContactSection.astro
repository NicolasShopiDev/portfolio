---
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; asPage?: boolean }
const { lang, asPage = false } = Astro.props;
const s = t(lang);
const Heading = asPage ? 'h1' : 'h2';
---
<section class="contact section" id="contact">
  <div class="container contact-grid">
    <div class="contact-left">
      <Heading class="contact-heading" set:html={s.contactHeading} />
    </div>
    <div class="contact-right">
      <p class="contact-desc">{s.contactDesc}</p>
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/myklpqna" method="POST" novalidate>
        <input type="hidden" name="lang" value={lang} />
        <div class="form-row">
          <div class="form-field">
            <label for="f-name">{s.formName}</label>
            <input type="text" id="f-name" name="name" autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="f-email">{s.formEmail}</label>
            <input type="email" id="f-email" name="email" autocomplete="email" />
          </div>
        </div>
        <div class="form-field">
          <label for="f-msg">{s.formMessage}</label>
          <textarea id="f-msg" name="message" rows="6"></textarea>
        </div>
        <div class="form-field">
          <label for="f-source">{s.formSource}</label>
          <select id="f-source" name="source">
            <option value="">{s.formSourceEmpty}</option>
            {Object.entries(s.formSources).map(([value, text]) => <option value={value}>{text}</option>)}
          </select>
        </div>
        <button type="submit" class="btn btn--dark">{s.formSubmit}</button>
      </form>
      <div class="contact-links">
        <a href="mailto:nicolasmhbusiness@gmail.com" class="clink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          nicolasmhbusiness@gmail.com
        </a>
        <a href="https://www.linkedin.com/in/nicolas-mateos-shopify/" target="_blank" rel="me noopener noreferrer" class="clink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
        <a href="https://www.upwork.com/freelancers/~0167007dc504c9b9ab" target="_blank" rel="me noopener noreferrer" class="clink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.5 8.5c-2.1 0-3.7 1.4-4.4 3.6-.9-1.8-1.5-4-1.9-5.6H8.5v7.8c0 1.5-1.2 2.7-2.7 2.7s-2.7-1.2-2.7-2.7V6.5H0v7.8C0 17.2 2.3 19.5 5.8 19.5c3.5 0 5.8-2.3 5.8-5.2v-1.3c.4 1.1 1.1 2.5 2 3.5l-1.7 7.5h3.4l1.1-5.2c1 .7 2.1 1.2 3.3 1.2 3.5 0 6.3-2.8 6.3-6.3-.1-2.6-2.2-5.2-5.5-5.2zm0 8.7c-.9 0-1.7-.4-2.4-1.1l.4-1.6.1-.5c.5-2.7 2-4.5 3.9-4.5 1.5 0 2.6 1.3 2.6 3-.1 2.6-2 4.7-4.6 4.7z"/></svg>
          Upwork
        </a>
        <a href="https://github.com/NicolasShopiDev" target="_blank" rel="me noopener noreferrer" class="clink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 015.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>
