---
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; route: RouteKey; switchHref?: string }
const { lang, route, switchHref } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-logo">
      <img src="/assets/logo/logo-white.svg" alt="Nicolás Mateos" class="footer-logo-img" width="140" height="20" loading="lazy" />
    </div>
    <p class="footer-bio" set:html={s.footerBio} />
    <nav class="footer-nav" aria-label={lang === 'es' ? 'Pie de página' : 'Footer'}>
      <a href={routes.home[lang]}>{s.home}</a>
      <a href={routes.projects[lang]}>{s.navProjects}</a>
      <a href={routes.code[lang]}>{s.navCode}</a>
      <a href={routes.about[lang]}>{s.navAbout}</a>
      <a href={routes.blog[lang]}>{s.navBlog}</a>
      <a href={routes.contact[lang]}>{s.navContact}</a>
      <a href={switchHref ?? routes[route][other]} hreflang={other} lang={other}>{s.switchLabel}</a>
    </nav>
    <div class="footer-social">
      <a href="https://www.linkedin.com/in/nicolas-mateos-shopify/" target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn" class="social-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <a href="https://github.com/NicolasShopiDev" target="_blank" rel="me noopener noreferrer" aria-label="GitHub" class="social-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 015.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
      </a>
    </div>
    <p class="footer-copy">© <span id="copyright-year">2026</span> Nicolás Mateos. {s.footerRights}</p>
  </div>
</footer>
