---
// Decorative rain of letters and numbers for the sections that show code: black glyphs
// falling down the white background, behind the panels. Nothing here carries meaning, so
// the canvas is hidden from assistive tech and never takes a pointer event.
//
// The canvas is one viewport tall and sticks while you scroll the section, so the repaint
// cost stays the same however tall the section grows. It only runs while the section is on
// screen, and prefers-reduced-motion gets a single still frame instead of the animation.
---
<div class="code-rain" aria-hidden="true">
  <canvas data-code-rain></canvas>
</div>

<script>
  // Letters, numbers and the punctuation that makes a wall of text read as code.
  const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789{}[]<>/\=;:+*$&|!?#';
  const COL_W = 18;      // px between columns
  const FRAME_MS = 45;   // ~22 fps: falling text does not need 60 repaints a second
  const FADE = 0.05;    // white laid down each frame, which is how fast a trail dissolves
  const SPEED = [0.45, 1.15]; // rows per frame

  const glyph = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function rain(canvas) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let cols = [];
    let w = 0, h = 0, rowH = 0, rows = 0;
    let timer = 0, last = 0, running = false;

    // A column starts above the top edge at a random height, so they never fall as one wall.
    const column = () => ({
      y: -Math.random() * rows * 0.9,
      speed: SPEED[0] + Math.random() * (SPEED[1] - SPEED[0]),
    });

    function measure() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Space Mono is already loaded by the layout; the fallback only matters for the first frames.
      ctx.font = `${COL_W - 3}px 'Space Mono', monospace`;
      ctx.textBaseline = 'top';
      rowH = COL_W * 1.2;
      rows = Math.ceil(h / rowH) + 2;
      const count = Math.ceil(w / COL_W);
      cols = Array.from({ length: count }, (_, i) => cols[i] || column());
    }

    function paint(x, row, alpha) {
      ctx.fillStyle = `rgba(10,10,10,${alpha})`;
      ctx.fillText(glyph(), x, row * rowH);
    }

    function frame(now) {
      timer = requestAnimationFrame(frame);
      if (now - last < FRAME_MS) return;
      last = now;

      // The trails are not redrawn: this white veil is what eats them, one frame at a time.
      ctx.fillStyle = `rgba(255,255,255,${FADE})`;
      ctx.fillRect(0, 0, w, h);

      cols.forEach((col, i) => {
        const from = Math.floor(col.y);
        col.y += col.speed;
        const to = Math.floor(col.y);
        for (let row = from + 1; row <= to; row++) {
          if (row >= 0 && row < rows) paint(i * COL_W, row, 0.9);
        }
        if (col.y > rows) cols[i] = column();
      });
    }

    // One frozen frame: every column caught mid-fall, fading out behind its head.
    function freeze() {
      ctx.clearRect(0, 0, w, h);
      cols.forEach((col, i) => {
        const head = Math.random() * rows;
        for (let n = 0; n < 18; n++) {
          const row = Math.floor(head - n);
          if (row < 0) break;
          paint(i * COL_W, row, 0.9 * Math.pow(1 - FADE, n * 3));
        }
      });
    }

    function play() {
      if (running) return;
      running = true;
      last = 0;
      timer = requestAnimationFrame(frame);
    }

    function pause() {
      running = false;
      cancelAnimationFrame(timer);
    }

    measure();
    if (still) {
      freeze();
      return;
    }

    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? play() : pause()),
      { rootMargin: '200px 0px' },
    ).observe(canvas.parentElement || canvas);

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 150);
    }).observe(canvas);
  }

  document.querySelectorAll('[data-code-rain]').forEach(rain);
</script>
