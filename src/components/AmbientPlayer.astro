---
// DRAFT, not in use: nothing imports this component. See src/views/CodeView.astro.
//
// The joke at the bottom right of the code page: a button that offers to set the mood and
// plays Clubbed to Death, the track from the lobby of The Matrix. Everyone who has read a
// screen of falling green characters knows the one.
//
// Spotify instead of a video: the embed is a player bar, so this stays a sound joke and not
// a video in the corner. Nothing is requested from Spotify until somebody presses the button,
// and closing the panel destroys the player, which stops the music.
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

// Clubbed To Death (Kurayamino Variation), Rob Dougan. Visitors signed in to Spotify hear the
// whole thing; everyone else gets the thirty-second preview Spotify allows, hence the link out.
const TRACK = '4BSoQxTQWNHgktgbEwzeEk';

const copy = {
  es: {
    open: '¿Por qué no le damos ambiente?',
    short: '¿Ambiente?',
    aria: 'Poner música de fondo',
    note: 'The Matrix (1999). La del vestido rojo.',
    close: 'Quitar la música',
    full: 'Escúchala entera en Spotify',
  },
  en: {
    open: 'Shall we set the mood?',
    short: 'Mood?',
    aria: 'Play background music',
    note: 'The Matrix (1999). The woman in the red dress.',
    close: 'Stop the music',
    full: 'Hear it in full on Spotify',
  },
}[lang];
---
<div class="ambient" data-ambient data-track={TRACK}>
  <div class="ambient-panel" id="ambient-panel" hidden>
    <div class="ambient-head">
      <p class="ambient-note">{copy.note}</p>
      <button class="ambient-close" type="button" data-ambient-close aria-label={copy.close}>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <div class="ambient-frame" data-ambient-frame></div>
    <a class="ambient-full" href={`https://open.spotify.com/track/${TRACK}`}
       target="_blank" rel="noopener noreferrer">{copy.full} ↗</a>
  </div>

  <button class="ambient-toggle" type="button" data-ambient-toggle
          aria-expanded="false" aria-controls="ambient-panel" aria-label={copy.aria}>
    <span class="ambient-eq" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="ambient-text">{copy.open}</span>
    <span class="ambient-text ambient-text--short">{copy.short}</span>
  </button>
</div>

<script>
  // Spotify's own embed API, loaded on the first click and never before. It is what lets the
  // track start on its own: the click on the button is the gesture the browser asks for.
  const API_SRC = 'https://open.spotify.com/embed/iframe-api/v1';
  let api = null;

  function spotify() {
    if (!api) {
      api = new Promise((resolve, reject) => {
        window.onSpotifyIframeApiReady = resolve;
        const script = document.createElement('script');
        script.src = API_SRC;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }
    return api;
  }

  function player(root) {
    const toggle = root.querySelector('[data-ambient-toggle]');
    const panel = root.querySelector('#ambient-panel');
    const frame = root.querySelector('[data-ambient-frame]');
    const closer = root.querySelector('[data-ambient-close]');
    const track = root.dataset.track;
    if (!toggle || !panel || !frame || !track) return;

    let controller = null;

    function open() {
      panel.hidden = false;
      root.classList.add('is-open', 'is-playing');
      toggle.setAttribute('aria-expanded', 'true');
      closer?.focus();

      const host = document.createElement('div');
      frame.replaceChildren(host);
      spotify()
        .then((API) => {
          API.createController(host, { uri: `spotify:track:${track}`, width: '100%', height: 80 }, (c) => {
            controller = c;
            // play() only takes once the embed says it is ready; calling it earlier does nothing.
            c.addListener('ready', () => c.play());
          });
        })
        // Blocked or offline: the panel keeps the link out, so the joke still lands.
        .catch(() => frame.replaceChildren());
    }

    function close() {
      panel.hidden = true;
      root.classList.remove('is-open', 'is-playing');
      toggle.setAttribute('aria-expanded', 'false');
      controller?.destroy();
      controller = null;
      frame.replaceChildren(); // dropping the player is what stops the music
    }

    toggle.addEventListener('click', () => (root.classList.contains('is-open') ? close() : open()));
    closer?.addEventListener('click', () => { close(); toggle.focus(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) { close(); toggle.focus(); }
    });
  }

  document.querySelectorAll('[data-ambient]').forEach(player);
</script>
