---
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; moreLink?: boolean }
const { lang, moreLink = true } = Astro.props;
const s = t(lang);
---
<section class="about section" id="about">
  <div class="container about-grid">
    <div class="about-left">
      <p class="section-label">{s.aboutLabel}</p>
      <h2 class="about-heading">{s.aboutHeading}</h2>
      <p class="about-text">{s.aboutP1}</p>
      <p class="about-text">{s.aboutP2}</p>
      <p class="about-text">{s.aboutP3}</p>
      {moreLink && <a class="text-link" href={routes.about[lang]}>{s.aboutMore}</a>}
    </div>
    <div class="about-right">
      <div class="skills-cols">
        <div class="skill-col">
          <h3>{s.skillsPlatforms}</h3>
          <ul>{s.skills.platforms.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="skill-col">
          <h3>{s.skillsStack}</h3>
          <ul>{s.skills.stack.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="skill-col">
          <h3>{s.skillsSpecialties}</h3>
          <ul>{s.skills.specialties.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>
