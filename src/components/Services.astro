---
// Home "Servicios" block: one card per service with a link to its page (plan 1.3, internal links).
// The English Plus card links to the existing Functions service page.
import { docPath, routes, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    label: 'Servicios',
    heading: 'Qué hago',
    items: [
      { title: 'Portales mayoristas en Shopify B2B', text: 'Empresas, catálogos, listas de precios, precios por tramos y tablas de pedido por variantes, con o sin Shopify Plus.', href: routes.b2b.es, link: 'Desarrollo Shopify B2B' },
      { title: 'Shopify Plus: Functions y Checkout', text: 'Shopify Functions en JavaScript y Rust, extensiones de checkout y de cuenta de cliente, y apps embebidas a medida.', href: routes.plus.es, link: 'Desarrollo Shopify Plus' },
      { kicker: 'GEO y SEO para Shopify', title: 'Tu marca y tus productos, más fáciles de encontrar y citar en IA', text: 'Auditoría, contenido y mejoras técnicas para que buscadores y asistentes comprendan tu tienda. Con una línea base y seguimiento de menciones, citas y contactos.', href: docPath('services', 'geo-shopify', 'es'), link: 'Consultoría GEO para Shopify' },
    ],
  },
  en: {
    label: 'Services',
    heading: 'What I do',
    items: [
      { title: 'Shopify B2B wholesale portals', text: 'Companies, catalogs, price lists, volume tiers and variant order tables, with or without Shopify Plus.', href: routes.b2b.en, link: 'Shopify B2B development' },
      { title: 'Shopify Plus: Functions and Checkout', text: 'Shopify Functions in JavaScript and Rust, checkout and customer account extensions, and custom embedded apps.', href: docPath('services', 'shopify-functions', 'en'), link: 'Custom Shopify Functions' },
      { kicker: 'Shopify GEO and SEO', title: 'Make your brand and products easier to find and cite in AI', text: 'Audits, content and technical improvements to help search engines and assistants understand your store. With a baseline and tracking of mentions, citations and enquiries.', href: docPath('services', 'geo-shopify', 'en'), link: 'Shopify GEO consulting' },
    ],
  },
}[lang];
---
<section class="services section" id="services" aria-labelledby="services-title">
  <div class="container">
    <p class="section-label">{copy.label}</p>{' '}
    <h2 class="about-heading" id="services-title">{copy.heading}</h2>{' '}
    <ul class="services-grid">
      {copy.items.map((item) => (
        <><li class="service-card">
          <h3 class="service-card-title">{item.title}</h3>{' '}
          <p class="service-card-text">{item.text}</p>{' '}
          <a class="text-link" href={item.href}>{item.link}</a>
        </li>{' '}</>
      ))}
    </ul>
  </div>
</section>
