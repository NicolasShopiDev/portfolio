---
import Logo from './Logo.astro';
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; route: RouteKey; switchHref?: string }
const { lang, route, switchHref } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const home = routes.home[lang];
// On the home page the CTA scrolls to the contact section; elsewhere it opens the contact page.
const ctaHref = route === 'home' ? '#contact' : routes.contact[lang];
const langHref = switchHref ?? routes[route][other];

// Service pages that exist in this language, with the hub last: the two flagship pages are what
// people come for, the rest of the silo lives behind it. The English Plus page comes in batch 2.
const services = [
  { key: 'b2b', label: s.navB2b, href: routes.b2b[lang] },
  { key: 'plus', label: s.navPlus, href: lang === 'es' ? routes.plus.es : undefined },
  { key: 'services', label: s.servicesAll, href: routes.services[lang] },
].filter((x): x is { key: RouteKey; label: string; href: string } => Boolean(x.href));
const inServices = services.some((x) => x.key === route);

// One list, two places: the row on a wide screen and the drop-down behind the burger on a phone.
const links = [
  { key: 'projects', href: routes.projects[lang], label: s.navProjects },
  { key: 'code', href: routes.code[lang], label: s.navCode },
  { key: 'about', href: routes.about[lang], label: s.navAbout },
  { key: 'blog', href: routes.blog[lang], label: s.navBlog },
];
---
<header class="nav" id="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" id="nav-burger" aria-expanded="false" aria-controls="nav-menu"
            aria-label={lang === 'es' ? 'Menú' : 'Menu'}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <nav class="nav-left" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <div class="nav-services">
        <button type="button" class="nav-services-toggle" aria-expanded="false" aria-controls="nav-services-list" data-current={inServices ? 'true' : undefined}>
          {s.navServices}<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <ul class="nav-services-list" id="nav-services-list">
          {services.map((x) => <li><a href={x.href} aria-current={route === x.key ? 'page' : undefined}>{x.label}</a></li>)}
        </ul>
      </div>
      {links.map((link) => (
        <a href={link.href} aria-current={route === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a href={route === 'home' ? '#hero' : home} class="nav-logo">
      <Logo class="nav-logo-img" />
    </a>
    <div class="nav-right">
      <a href={langHref} class="nav-lang" hreflang={other} lang={other}><span aria-hidden="true">{other.toUpperCase()}</span><span class="visually-hidden">{s.switchLabel}</span></a>
      <a href={ctaHref} class="nav-cta">{s.cta}</a>
    </div>
  </div>

  <div class="nav-menu" id="nav-menu">
    <nav aria-label={lang === 'es' ? 'Menú del móvil' : 'Mobile menu'}>
      {/* The service pages go in the phone menu as plain links: a drop-down inside a drop-down is a trap. */}
      {services.map((x) => (
        <a href={x.href} aria-current={route === x.key ? 'page' : undefined}>{x.label}</a>
      ))}
      {links.map((link) => (
        <a href={link.href} aria-current={route === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href={langHref} hreflang={other} lang={other} class="nav-menu-lang">{s.switchLabel}</a>
    </nav>
  </div>
</header>
